# PaperBrief settings.
# Copy this file to .env and fill in the values. Never commit .env.

# --- OpenAI (required) ---
OPENAI_API_KEY=
# Report and Q&A model
OPENAI_MODEL=gpt-6.1-sol
# Batch one-line summary model for the paper list
OPENAI_SUMMARY_MODEL=gpt-6-luna

# --- App ---
PAPERBRIEF_PORT=8765
# Contact (email) sent in the arXiv API User-Agent
PAPERBRIEF_ARXIV_CONTACT=
# Data folder. Default: Windows %LOCALAPPDATA%\PaperBrief, Linux ~/.local/share/PaperBrief
# PAPERBRIEF_DATA_DIR=
# 1 = use tests/fixtures instead of the network (tests and demos)
# PAPERBRIEF_OFFLINE=1

# --- MinerU ---
# standard needs an NVIDIA GPU; basic runs on CPU
PAPERBRIEF_MINERU_TIER=standard
# No Hugging Face token is needed. Everything below is optional.
# Model source: auto | huggingface | modelscope | local
# MINERU_MODEL_SOURCE=auto
# VLM engine. Windows: lmdeploy | llama-cpp. Linux: vllm | lmdeploy | llama-cpp
# MINERU_MODEL_VLM_ENGINE=auto
# Model cache root. Default: ~/.mineru
# MINERU_HOME=
# Set only if model downloads hang behind a firewall
# HF_HUB_DISABLE_XET=1
